APP_NAME=Connectify
APP_ENV=production
APP_DEBUG=true
APP_URL=https://connectify-bw2w.onrender.com

LOG_CHANNEL=errorlog
LOG_LEVEL=debug

# Database — Render injects DATABASE_URL automatically
DB_CONNECTION=pgsql

# Session & Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# AI Providers
AI_PROVIDER=groq
